# Copy to .env.local for local development. Never commit real values.
# What each variable is for and where real values are kept: docs/environments.md
# Local database (npm run setup prints the same URL):
DATABASE_URL=postgres://postgres@localhost:54331/accounts
# Public URL of this app.
APP_URL=http://localhost:3100
# Supabase Auth. With the local Supabase Auth server (npm run auth:local), copy these three from
# .data/auth/local.env. For accounts-dev, from the Supabase dashboard (never commit them).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# OAuth client ids of the Outside In products, approved without a consent prompt (comma-separated).
FIRST_PARTY_CLIENT_IDS=
# Origins product callbacks may redirect to (comma-separated, e.g. http://localhost:3000). Empty refuses every OAuth redirect.
PRODUCT_REDIRECT_ORIGINS=
